{
	"name": "strange-loops-lab",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"smoke:dialogue": "node scripts/smoke_dialogue.mjs",
		"smoke:persistence": "node scripts/smoke_persistence.mjs",
		"smoke:all": "node scripts/smoke_all.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check_dead_css.mjs",
		"check:dead-css": "node scripts/check_dead_css.mjs",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.65.2",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"typescript": "^5.9.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.1",
		"@types/better-sqlite3": "^7.6.13",
		"better-sqlite3": "^12.6.2",
		"elkjs": "^0.11.1",
		"tailwindcss": "^4.2.1"
	}
}
